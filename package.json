{
	"name": "@charliewilco/extensions",
	"version": "0.1.0",
	"description": "A strict TypeScript web components library",
	"type": "module",
	"scripts": {
		"build": "npm run clean && tsc -p tsconfig.json && rolldown -c",
		"clean": "node scripts/clean.js dist",
		"clean:examples": "node scripts/clean.js examples/dist",
		"typecheck": "tsc --noEmit",
		"dev": "rolldown -c -w",
		"examples:dev": "parcel examples/index.html",
		"examples:build": "npm run clean:examples && parcel build examples/index.html --dist-dir examples/dist --public-url ./",
		"test": "node --import tsx --import ./test/setup.ts --test test/*.test.ts",
		"lint": "biome lint .",
		"format": "biome format . --write",
		"format:check": "biome format ."
	},
	"files": [
		"dist",
		"docs",
		"README.md",
		"LICENSE"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./button-group": {
			"types": "./dist/button-group.d.ts",
			"import": "./dist/button-group.js"
		},
		"./accordion": {
			"types": "./dist/accordion.d.ts",
			"import": "./dist/accordion.js"
		},
		"./alert": {
			"types": "./dist/alert.d.ts",
			"import": "./dist/alert.js"
		},
		"./avatar": {
			"types": "./dist/avatar.d.ts",
			"import": "./dist/avatar.js"
		},
		"./badge": {
			"types": "./dist/badge.d.ts",
			"import": "./dist/badge.js"
		},
		"./dialog": {
			"types": "./dist/dialog.d.ts",
			"import": "./dist/dialog.js"
		},
		"./tooltip": {
			"types": "./dist/tooltip.d.ts",
			"import": "./dist/tooltip.js"
		},
		"./input-group": {
			"types": "./dist/input-group.d.ts",
			"import": "./dist/input-group.js"
		},
		"./loading-spinner": {
			"types": "./dist/loading-spinner.d.ts",
			"import": "./dist/loading-spinner.js"
		},
		"./switch-toggle": {
			"types": "./dist/switch-toggle.d.ts",
			"import": "./dist/switch-toggle.js"
		},
		"./custom-checkbox": {
			"types": "./dist/custom-checkbox.d.ts",
			"import": "./dist/custom-checkbox.js"
		},
		"./toast-notification": {
			"types": "./dist/toast-notification.d.ts",
			"import": "./dist/toast-notification.js"
		},
		"./skeleton": {
			"types": "./dist/skeleton.d.ts",
			"import": "./dist/skeleton.js"
		},
		"./dropdown-menu": {
			"types": "./dist/dropdown-menu.d.ts",
			"import": "./dist/dropdown-menu.js"
		},
		"./sortable-table": {
			"types": "./dist/sortable-table.d.ts",
			"import": "./dist/sortable-table.js"
		},
		"./tab-lock": {
			"types": "./dist/tab-lock.d.ts",
			"import": "./dist/tab-lock.js"
		},
		"./card": {
			"types": "./dist/card.d.ts",
			"import": "./dist/card.js"
		},
		"./datepicker": {
			"types": "./dist/datepicker.d.ts",
			"import": "./dist/datepicker.js"
		},
		"./carousel": {
			"types": "./dist/carousel.d.ts",
			"import": "./dist/carousel.js"
		},
		"./combobox": {
			"types": "./dist/combobox.d.ts",
			"import": "./dist/combobox.js"
		},
		"./slider": {
			"types": "./dist/slider.d.ts",
			"import": "./dist/slider.js"
		},
		"./collapsible": {
			"types": "./dist/collapsible.d.ts",
			"import": "./dist/collapsible.js"
		},
		"./toggle": {
			"types": "./dist/toggle.d.ts",
			"import": "./dist/toggle.js"
		},
		"./progress": {
			"types": "./dist/progress.d.ts",
			"import": "./dist/progress.js"
		},
		"./separator": {
			"types": "./dist/separator.d.ts",
			"import": "./dist/separator.js"
		}
	},
	"sideEffects": [
		"./dist/*.js",
		"./src/*.ts",
		"./examples/index.js"
	],
	"devDependencies": {
		"@biomejs/biome": "^2.5.5",
		"@happy-dom/global-registrator": "^20.11.1",
		"@types/node": "^26.1.1",
		"happy-dom": "^20.11.1",
		"parcel": "^2.16.4",
		"rolldown": "^1.2.0",
		"tsx": "^4.23.1",
		"typescript": "^7.0.2"
	}
}
